# Production reverse proxy, installed to /etc/caddy/Caddyfile by deploy.sh.
# Caddy terminates TLS for the duckdns hostname and serves the built frontend;
# everything the backend owns has to be routed here explicitly, because the
# catch-all below falls back to the SPA.
exhibition-traffic.duckdns.org {
	# Without this Caddy journals warnings only, so there is no record that a
	# request ever arrived. On 2026-08-30 an uptime monitor mailed "server
	# down" five times and the first question — did those checks reach the box
	# at all, or did DNS/network drop them — had no answer anywhere. It was
	# eventually settled from other evidence, but the opposite cause would
	# have been unprovable.
	#
	# JSON to a rolling file rather than the journal: the journal is already
	# carrying the backend's own logs, and access lines are the volume here.
	#
	# 20MiB x 20 caps this at 400MB on a 45GB disk. It was x5, sized when the
	# only reader was a person answering "did that request arrive". /analytics
	# reads the same file as the visitor history, and there the roll window IS
	# the retention: once the oldest file is deleted those days are gone from
	# the trend. Quadrupling the window is the whole defence, and it costs
	# 300MB of a disk that has 40GB free.
	#
	# mode: the backend runs as `ubuntu` (deploy/exhibition-backend.service)
	# and Caddy creates this file 0600 as its own user, so without it
	# /analytics/visits reads an empty window on production and nowhere else.
	# Nothing secret is in an access line that isn't already in the request.
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 20
			mode 0644
		}
	}

	# 응답 압축. 이 사이트에서 제일 큰 응답은 /mmca/daily 다 — 2026-09-05 과천
	# 하루가 352KiB 이고, 수집 격자가 */10 에서 */2 로 촘촘해지며 8월 말의
	# 34KiB 에서 10배 늘었다. 포인트마다 방 8개의 코드와 이름을 다시 싣는
	# 구조(481포인트 x 8)라 반복이 극단적이고, 그래서 gzip 이 그 응답을
	# **5.2KiB(-98.5%)** 로 줄인다. MmcaPage 가 60초마다 다시 받으므로 탭 하나가
	# 시간당 21MB 였다. 페이로드 모양을 바꾸는 것보다 이 한 줄이 먼저다.
	#
	# 정적 자산도 같이 걸린다 — 번들 index-*.js 209KiB → 64KiB, css 15KiB →
	# 3.8KiB. 백엔드의 GZipMiddleware 가 아니라 여기인 이유가 그것이다: SPA 는
	# 백엔드를 거치지 않고, Caddy 는 이미 두 경로 모두의 앞에 있다.
	#
	# 기본 대상 목록에 text/* 가 있어 /congestion/stream 의 SSE 도 압축된다.
	# 그래도 두는 것은 caddy 2.11.4 로 재 보니 이벤트마다 그대로 flush 되어
	# 도착 간격(0.3s)이 압축 없을 때와 같았기 때문이다. 실시간 갱신이 밀리는
	# 증상이 보이면 여기서 match 로 text/event-stream 을 빼는 것이 그 손잡이다.
	encode gzip

	# 방문 집계(/visitors 가 읽는다). 위 log 블록이 쓰는 그 파일을 백엔드가
	# 되읽는 것이라, 이 줄이 빠지면 SPA 폴백이 index.html 로 200 을 답해
	# 프론트가 JSON 파싱에서 실패한다.
	handle /analytics/* {
		reverse_proxy localhost:8000
	}

	handle /congestion/* {
		reverse_proxy localhost:8000
	}

	handle /mmca/* {
		reverse_proxy localhost:8000
	}

	# 국중박 전시 목록. 혼잡도는 /congestion/* 로 오지만(그 시절 이름) 전시는
	# 관 이름을 접두로 쓴다. 새 접두는 여기와 frontend/vite.config.ts 두 곳에
	# 다 적어야 한다 — 위 /analytics 주석과 같은 이유다.
	handle /national-museum/* {
		reverse_proxy localhost:8000
	}

	# /health* rather than /health/*, so both the liveness endpoint and
	# /health/collection match. Without this the SPA fallback answers 200 with
	# index.html for both, which an uptime monitor reads as a healthy backend
	# no matter how long collection has been dead.
	handle /health* {
		reverse_proxy localhost:8000
	}

	handle {
		root * /var/www/exhibition-traffic
		try_files {path} /index.html
		file_server
	}
}
