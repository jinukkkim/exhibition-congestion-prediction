# Config for scripts/pull_prod_db.sh / scripts/dev.sh. Kept out of .env
# because Settings (app/config.py) reads .env with unknown keys forbidden —
# this file is dev-tooling only, never read by the app itself.
DEPLOY_HOST=
DEPLOY_USER=ubuntu
DEPLOY_SSH_KEY=

# Optional knobs, both with sensible defaults — see README "Developing against
# real data". Set them here only if you want a different default every run;
# otherwise pass them inline (DB_MAX_AGE=0 scripts/dev.sh).
#
# DB_MAX_AGE — seconds before dev.sh re-pulls the DB. 0 always pulls, "inf"
# never does. Default 1800.
#DB_MAX_AGE=1800
#
# RAW_RESPONSE_KEEP_DAYS — how many recent days keep their archived /citydata
# bodies in the dev snapshot. Older rows keep every parsed column and lose only
# the extra fields the archived body adds. Default 7.
#RAW_RESPONSE_KEEP_DAYS=7
